st.set_page_config(
    page_title="Audit Kompatibilitas Bahan Kimia",
    page_icon="🧪"
)

st.title("🧪 Audit Kompatibilitas Penyimpanan Bahan Kimia")

st.write(
    "Aplikasi ini digunakan untuk memeriksa kompatibilitas penyimpanan bahan kimia laboratorium."
)

st.sidebar.title("Menu Audit")

kategori = [
    "Flammable",
    "Corrosive",
    "Oxidizing",
    "Toxic"
]

bahan1 = st.selectbox(
    "Pilih Kelompok Bahan Kimia Pertama",
    kategori
)

bahan2 = st.selectbox(
    "Pilih Kelompok Bahan Kimia Kedua",
    kategori
)

aturan = {

("Flammable","Oxidizing"):
"Tidak Kompatibel",

("Oxidizing","Flammable"):
"Tidak Kompatibel",

("Corrosive","Flammable"):
"Tidak Kompatibel",

("Flammable","Corrosive"):
"Tidak Kompatibel",

("Corrosive","Toxic"):
"Tidak Kompatibel",

("Toxic","Corrosive"):
"Tidak Kompatibel"
}

if st.button("Audit Sekarang"):

    if bahan1 == bahan2:

        st.success(
            "✅ Kelompok bahan yang sama umumnya dapat disimpan bersama."
        )

    elif (bahan1,bahan2) in aturan:

        st.error(
            "❌ Bahan tidak kompatibel dan harus dipisahkan."
        )

    else:

        st.warning(
            "⚠️ Periksa SDS untuk memastikan kompatibilitas."
        )

